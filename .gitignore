# Gradle / Android
.gradle/
build/
local.properties
captures/
*.apk
*.aab
.cxx/

# Signing keys. NOTHING is excepted here any more.
#
# There used to be a !keystore/debug.keystore line in this block, which
# deliberately un-ignored a shared debug key so every build signed with the
# same certificate. This repository was public while that key was committed,
# so the key must be treated as compromised. It has been removed from history
# and the exception is gone with it. A shared debug key belongs outside the
# repository.
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key

# Secrets and local settings
.env
.env.*
*.local

# IDE
.idea/
*.iml
.DS_Store

# Node
node_modules/

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Python bytecode
__pycache__/
*.py[cod]

# Rust / Tauri build output
jarvis-desktop/src-tauri/target/

# /brag skill scratch output: re-runnable timestamped duplicates and the
# npm install inside the composition (node_modules/ above already covers it)
# are not committed; the current brag-output/ deliverable is.
brag-output-*/
