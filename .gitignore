# Gradle / Android
.gradle/
build/
local.properties
captures/
*.apk
*.aab
.cxx/

# Signing keys. NOTHING is excepted here any more.
#
# There used to be a !keystore/debug.keystore line in this block, which
# deliberately un-ignored a shared debug key so every build signed with the
# same certificate. This repository was public while that key was committed,
# so the key must be treated as compromised. It has been removed from history
# and the exception is gone with it. A shared debug key belongs outside the
# repository.
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key

# Secrets and local settings
.env
.env.*
*.local

# IDE
.idea/
*.iml
.DS_Store

# Node
node_modules/

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Python bytecode
__pycache__/
*.py[cod]

# Rust / Tauri build output
jarvis-desktop/src-tauri/target/
tools/tool_eval/tool_eval_results.json

# /brag skill scratch output. The skill renders into brag-output/ (or a
# timestamped brag-output-*/); finished videos are copied into videos/vN/
# and committed there. node_modules/ above keeps npm installs out.
brag-output/
brag-output-*/

# Local git worktrees used for parallel background builders (each is a full
# checkout on its own branch, never meant to be committed - see the
# handoff's "at most 3-4 builders at once" note).
.claude/worktrees/

# ---------------------------------------------------------------------------
# Scratch that must never be swept in (added 2026-10-05).
#
# Five of these - dshwork/, the nested Epic-Jarvis-main/, final-run.txt,
# final-run2.txt and yt-out.txt - were excluded on THIS machine only, by
# .git/info/exclude. That file is never cloned, so it protected nothing
# anywhere else: on another machine, or after a fresh clone here, a plain
# `git add -A` would have swept about 88 MB of agent scratch into a public
# repository. The rules belong here, where they travel with the repository.
# None of them matches a tracked file; this adds no new ignore for anything
# the project actually keeps.
# ---------------------------------------------------------------------------

# Audit-pass scratch. dshwork/ also holds whole copies of the backend sources
# under audit-*/_stage/, which is exactly what backend/.gitignore keeps out of
# this repository on purpose.
dshwork/

# The DSH harness's own scratch folder (rule added 2026-10-09). It was NOT
# ignored, and it is far larger than dshwork/ ever was: measured 2026-10-09,
# 207,942 files and about 75 GB - pasted copies of the backend, test vaults,
# node_modules trees and whole browser profiles. Among them are
# AppData/Local/Chromium|Google/Chrome|Chrome Beta|Chrome SxS|Microsoft/Edge
# Beta|Edge Dev "User Data/Default/Login Data" and ".../Network/Cookies" -
# a credential store in a folder a plain `git add -A` would have committed.
# `git status --porcelain -uall` reported 4,104 paths under it. This is the
# same failure the dshwork/ note above records, found a second time: that
# note fixed the folder it named and this one was left uncovered.
# It also made tools/check_literal_keys.py red locally while CI stayed green,
# because the checker reads this folder and finds a duplicate dict key in one
# of the pasted copies of jarvis_gate.py.
.dsh-scratch/

# The DSH agent's scratch TOOLS folder, and its scratchpad/ (rule added
# 2026-10-14). Neither was ignored, and both were TRACKED - five files and no
# rule covering any of them:
#
#   .dsh-scratch-tools/make_picture_card_patch.py   a throwaway script, and the
#       only in-tree writer of the tracked `backend/picture-card.patch`
#   scratchpad/admem/budget_measure.py              a measurement script
#   scratchpad/brain-sections/brain-0{1,2,3}-*.png  brain screenshots
#
# This is the same failure the dshwork/ and .dsh-scratch/ notes above record,
# found a third time: agent scratch that a plain `git add -A` sweeps into a
# public repository. Nothing here is read by code, a test or a workflow, so no
# build and no check needs any of it - the files stay on disk.
#
# Two of the five were NOT scratch and did not stay here. Both were named from
# somewhere else, so ignoring them in place would have broken a promise a
# document makes, and both moved to tools/ - where this project's other patch
# writers and measurement tools live:
#
#   tools/gen_picture_card_patch.py   was .dsh-scratch-tools/
#       make_picture_card_patch.py. The only in-tree writer of the TRACKED
#       backend/picture-card.patch (it writes it at its own line 51). The move
#       is path-neutral: it reads HERE = __file__.parent.parent, the repository
#       root from either folder.
#   tools/measure_admem_budget.py     was scratchpad/admem/budget_measure.py.
#       The script behind the numbers in docs/ADAPTIVE-MEMORY-DESIGN.md
#       section 8, which says it "is kept ... so the numbers can be re-run
#       rather than taken on trust"; that pointer was moved to match.
#
# What is left under the two rules below is scratch only: three brain
# screenshots, regenerated by using the app. A clone does not carry them, and
# nothing reads them.
# tools/check_no_scratch_in_the_tree.py is the guard that bites if one of these
# is tracked again.
.dsh-scratch-tools/
scratchpad/

# An accidental nested copy of the repository root. A directory of this name
# INSIDE the repository is never intended. This does not match the
# repository's own root: a .gitignore pattern is relative to the directory the
# file sits in.
Epic-Jarvis-main/

# Old suite and tool output pasted to the root by hand.
final-run*.txt
yt-out.txt

# Logs - the backend writes its own beside the live backend folder, never here.
*.log

# Stray package tarballs. One (@evidence-dev/telemetry 2.1.3, a third-party
# TELEMETRY package, which nothing imported) sat tracked in this repository
# until 2026-10-05, in a project whose first rule is that nothing leaves the PC.
*.tgz

# The generated source bundle. It sat tracked for three weeks at 13.5 MB - a
# snapshot of one branch, made for an outside audit, that no workflow, test or
# script ever read. Nothing enforced it, so it went stale silently: the copy
# deleted on 2026-10-05 was stamped with a commit on the branch `integ-obscura`,
# which no longer exists. It is regenerable in one line whenever a reviewer
# wants it, so it is not worth carrying: `py -3 tools/gen_source_bundle.py`.
# The generator itself stays tracked - it is the way to produce the file.
docs/SOURCE-BUNDLE.md

# Python virtualenvs.
.venv/
venv/

# The timestamped folder apply-patches.ps1 makes beside the backend it patches,
# holding the previous copy of every file it changes. It lives beside the live
# backend rather than in this repository, so this is only a guard against a
# stray copy being committed from here.
_jarvis-backup-*

# ---------------------------------------------------------------------------
# jarvis-backend/ is a published copy of the owner's live backend folder, and
# that folder carries two things which must never be published: his live
# settings file, and the patcher's _jarvis-logs/ transcripts (one of them names
# his absolute path 231 times). Added 2026-10-06 with the base itself.
#
# ANCHORED AT THE ROOT ON PURPOSE. A bare `jarvis-framework.toml` would also
# match backend/rebuilt/jarvis-framework.toml, which IS tracked: that file is
# the settings template a new user needs, and 23 settings in it are missing
# from the live one. jarvis-backend/.gitignore carries the folder-local rules.
# ---------------------------------------------------------------------------
/jarvis-framework.toml
/jarvis-framework.toml.backup-*
/_jarvis-logs/
