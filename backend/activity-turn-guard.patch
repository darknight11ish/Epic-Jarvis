+def _activity_status() -> dict:
+    """What /api/status says Jarvis is doing, and how long since progress.
+
+    activity-turn-guard.patch (2026-11-06): read-only and additive. The age is
+    the diagnostic half - "thinking" written four hours ago is the leftover
+    this patch exists for, and the next time something leaves one behind a
+    status call says so without reading this file. `age_s` is None when the
+    bus cannot be read, and the state word is "" then, never a guess.
+    """
+    try:
+        import jarvis_events
+        mark = jarvis_events.activity() or {}
+        age = jarvis_events.activity_age()
+        state = str(mark.get("state") or "")
+    except Exception:
+        return {"state": "", "age_s": None}
+    return {"state": state,
+            "age_s": None if age is None else round(float(age), 1)}
+
+
+def _activity_touch() -> None:
+    """One sign of progress from a streamed chunk: keep the mark fresh.
+
+    activity-turn-guard.patch (2026-11-06): jarvis_events.touch_activity()
+    stamps the mark without announcing anything, and is called for every chunk
+    the local answering loop and the cloud relay write - so a real long turn
+    can never look like the five-minute-old leftover the stale lease clears.
+    """
+    try:
+        import jarvis_events
+        jarvis_events.touch_activity()
+    except Exception:
+        pass
+
+
+def _busy_reason_for_status():
+    """Why the model is held right now, or None - for /api/status.
+
+    The same plain sentence the benchmark's 409 body carries. Reading it also
+    runs jarvis_power.in_flight(), which clears a stale activity mark, so a
+    status poll can heal a stuck mark as well as show it (read-only: no
+    setting, card or permission is touched).
+    """
+    try:
+        import jarvis_power
+        return jarvis_power.in_flight()
+    except Exception:
+        return None
+
+
