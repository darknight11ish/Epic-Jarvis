+# attached-file.patch (2026-10-29): does the newest message of this request
+# carry a file the owner attached - the app's `has_file` flag, or the
+# `attachment` field itself? Either one keeps the turn on THIS PC
+# (jarvis_router.choose(has_file=...), gate "file"): a file's words can be
+# anything, and they ride in the NEWEST user turn - the one a cloud request
+# keeps. The flag is a claim and the field is the thing, so both are asked,
+# through jarvis_agent's own one walk. A PC that cannot say stays home.
+def _file_turn(body) -> bool:
+    try:
+        if body.get("has_file") is True:
+            return True
+        import jarvis_agent
+        return bool(jarvis_agent.newest_turn_has_file(body.get("messages")))
+    except Exception:
+        return True
+
