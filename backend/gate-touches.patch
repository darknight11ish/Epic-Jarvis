+def _target_blobs(action: str, detail: Any, prompt: str) -> tuple:
+    """The blobs the PROTECTED rule may read - the action's TARGET, not its card.
+
+    WHICH QUESTION THIS ANSWERS. The rule above the tier table exists so that
+    nothing an action the gate approves can rewrite the POLICY or the GATE:
+    "if the policy and the gate are writable by an action the gate itself
+    approves, there is no gate - just a longer path to the off switch". That
+    is a question about what the action would TOUCH - its target - and not
+    about the words printed on its card.
+
+    WHAT ARRIVES IN EACH ARGUMENT (measured across every caller, 2026-10-10):
+
+      `detail`  the action's own parameters. Every route that raises a card
+                builds it - {"what": ..., "path": ..., "settings": ..., "to":
+                ...} - and it is the same dict `_redact` describes as "the
+                recipient of the email, the path of the file, the body of the
+                shell command". Its values are searched, EXCEPT the keys in
+                _PROSE_KEYS, which hold the card's own text.
+
+      `prompt`  EITHER a tool call - OpenJarvis's confirm callback, whose
+                prompt is `Allow execution of tool '<name>' with args {json}?`,
+                and jarvis_agent's own `tool <name> {json}` (whole since
+                DEF-003; jarvis_mcp's `call` whole since DEF-012) - OR the card's text.
+                The route callers (jarvis_backup, jarvis_asks_first,
+                jarvis_mcp, jarvis_task_control and the rest) hand the gate the
+                card text as the prompt, because that is what a person reads.
+
+    So the prompt counts ONLY where it carries arguments: the JSON object
+    inside it is taken, and the prose around it is not. A prompt with no JSON
+    in it is prose, and prose is not a target. Nothing the model writes stops
+    being read - a model's arguments reach the gate as JSON on every path
+    (OpenJarvis quotes the tool call, jarvis_agent writes
+    `tool <name> {json}`, and a route card's arguments are in `detail`) - and
+    no wording of a card can reach this rule at all. A tool call whose
+    arguments were cut short is still read, from the raw text of the call
+    line: `_TOOL_CALL_PROMPTS` says why that cannot reach a card's words.
+
+    Returns the strings to search.
+    """
+    blobs = []
+    try:
+        if isinstance(detail, dict):
+            searchable = {k: v for k, v in detail.items()
+                          if str(k).lower() not in _PROSE_KEYS}
+        else:
+            searchable = detail
+        blobs.append(json.dumps(searchable, default=str))
+    except Exception:
+        blobs.append(str(detail))
+    # The action NAME too: the two terminal actions jarvis_agent makes for
+    # itself are the tool's own name (`unclassified_tool:file_write`), and a
+    # name is chosen by the tool's author, never by the model.
+    blobs.append(str(action or ""))
+    for m in _JSON_OBJECT_RE.findall(prompt or ""):
+        try:
+            json.loads(m)
+        except Exception:
+            continue                      # braces in prose, not arguments
+        blobs.append(m)
+    # A CUT TOOL CALL STILL CARRIES ITS ARGUMENTS. A caller outside this
+    # project can still hand the gate a line cut at 1500 characters (this
+    # project's own callers stopped cutting in DEF-012, 2026-10-18), and a JSON
+    # object cut in half does not parse, so the loop just above dropped exactly
+    # the arguments this rule exists to read: measured 2026-10-11, arguments
+    # 3453 characters long with a write to the gate's own file at character 62
+    # left `['{}', 'run_shell_on_host']`, and the action was offered as an
+    # ordinary card a person could approve. (jarvis_agent's lines cut the same
+    # way until DEF-003.) What the action would TOUCH does not change because
+    # the line recording it is too short to hold it, so the raw argument text
+    # of a prompt that IS a tool-call line, end to end, is read as it stands.
+    # This can only ever ADD text to the search - nothing that was refused
+    # before can become allowed - and the match is anchored at both ends, so a
+    # card's own words still cannot reach this rule at all.
+    for pat in _TOOL_CALL_PROMPTS:
+        m = pat.match(prompt or "")
+        if m:
+            blobs.append(m.group("args"))
+            break
+    return tuple(blobs)
+
 
