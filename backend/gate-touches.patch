+#: The process-local copy of the latch (security audit 2026-10-18, I6). The
+#: database row is the latch; this is what keeps a private read from becoming
+#: a cloud lane when the row cannot be WRITTEN - the old code returned False
+#: from that except, i.e. created no latch at all. taint_active() already
+#: fails closed when the row cannot be READ; this makes latch_taint() fail
+#: closed too. In memory only: a restart loses it, and the next private read
+#: sets it again.
+_TAINT_FALLBACK_UNTIL = 0.0
+_TAINT_FALLBACK_WHY = ""
+
+
+def _latch_in_memory(seconds: float, why: str) -> None:
+    """Keep the latch in this process, never shorter than one already held."""
+    global _TAINT_FALLBACK_UNTIL, _TAINT_FALLBACK_WHY
+    try:
+        until = time.time() + max(0.0, float(seconds))
+    except Exception:
+        until = time.time() + 30.0 * 60.0
+    if until > _TAINT_FALLBACK_UNTIL:
+        _TAINT_FALLBACK_UNTIL = until
+        _TAINT_FALLBACK_WHY = str(why or "")[:200]
+
+
+def _memory_taint_active() -> bool:
+    return _TAINT_FALLBACK_UNTIL > time.time()
