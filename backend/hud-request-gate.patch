+_HUD_HEADER_TIMEOUT_SECONDS = 10.0
+_HUD_REQUEST_TIMEOUT_SECONDS = 600.0
+
+
+def _request_gate(base):
+    """Header deadline and request slots, at the server seam (SECPRIV N3).
+
+    `setup()` runs before the request line and headers are read, so the 10 s
+    deadline there is the slow-header defence. `parse_request()` then extends
+    the socket deadline to ten minutes, so SSE keepalives and slow model turns
+    are NOT cut; the socket deadline only matters again for a long-bodied
+    request. `_send` is the one place a 401 becomes the rate bucket's 429 -
+    routes are untouched. The class is built once, before the server starts.
+    """
+
+    class Gated(base):
+        def setup(self):
+            super().setup()
+            try:
+                self.connection.settimeout(_HUD_HEADER_TIMEOUT_SECONDS)
+            except OSError:
+                pass
+
+        def parse_request(self):
+            ok = super().parse_request()
+            if ok:
+                try:
+                    self.connection.settimeout(_HUD_REQUEST_TIMEOUT_SECONDS)
+                except OSError:
+                    pass
+            return ok
+
+        def _send(self, code, body, ctype="application/json; charset=utf-8",
+                  extra_headers=None):
+            try:
+                # sys.modules, not an import statement: test_devices pins the ORDER of
+                # the owner-check module-load in main(), and a second load
+                # before it would move that landmark. The module is loaded at boot before
+                # the server starts; if it is not, the bucket is simply off.
+                _oc = sys.modules.get("jarvis_owner_check")
+                peer = (self.client_address or ("",))[0]
+                if _oc is not None and code == 401 and _oc.TOKEN_FAILURES.blocked(peer):
+                    code = 429
+                    body = {"ok": False, "refused": True,
+                            "error": "too many bad tokens - wait a minute",
+                            "words": "Too many bad tokens were sent, so this "
+                                     "PC is refusing for a minute. Nothing was "
+                                     "read and nothing was changed."}
+                    extra_headers = list(extra_headers or []) + [
+                        ("Retry-After", "60")]
+            except Exception:
+                pass
+            return super()._send(code, body, ctype, extra_headers)
+
+    return Gated
+
