 """
 
 
+#: The last local-model call that failed, in closed-world words: the exception
+#: class or an empty answer, the HTTP status, the wall duration and Ollama's
+#: own `done_reason`. Never the prompt and never the answer - `done_reason` is
+#: one of Ollama's fixed words and a duration is a number.
+#:
+#: WHY (2026-10-28, DEF-017). `_local_llm` swallowed every exception into None,
+#: so the learner could only say "reached no model ... Is it pulled?" for a
+#: timeout, an HTTP error, an {"error"} body and an empty answer alike. On the
+#: owner's own PC the model was loaded the whole time, so that message pointed
+#: away from the real cause.
+LAST_LLM_FAILURE: Optional[dict] = None
+
+
+def local_llm_failure() -> Optional[dict]:
+    """Why the last local-model call failed, or None when it did not."""
+    return dict(LAST_LLM_FAILURE) if LAST_LLM_FAILURE else None
+
+
+def _note_llm_failure(kind: str, started: float, *, status=None,
+                      done_reason=None) -> None:
+    """Record one closed-world reason and hand it to the learner's counters.
+
+    Called from `_local_llm` only. The reason is also written through
+    `jarvis_auto_learn.note_model_failure`, which `/api/memory/learning`
+    already reads back - so the HUD and both apps can say WHY the model did not
+    answer without any of them holding a prompt or an answer.
+    """
+    global LAST_LLM_FAILURE
+    reason = {"kind": str(kind), "status": status,
+              "seconds": round(time.monotonic() - started, 3), "at": time.time()}
+    if done_reason:
+        reason["done_reason"] = str(done_reason)
+    LAST_LLM_FAILURE = reason
+    try:
+        import jarvis_auto_learn as _learner
+        _learner.note_model_failure(reason)
+    except Exception:
+        pass                 # bookkeeping must never break the call it counts
+
+
