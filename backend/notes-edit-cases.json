{
  "_comment": "Generated by tools/gen_notes_cases.py from backend/jarvis_notes_edit.py. Do not edit by hand. ONE shared copy for both apps: the desktop's and the phone's contract tests read this shape; re-run the generator after any contract change.",
  "contract": "docs/JARVIS-API.md section 170",
  "action": "edit_vault_note",
  "tier": "ask",
  "limits": {
    "max_file_bytes": 2097152,
    "max_notes": 2000,
    "max_waiting": 4,
    "max_query_chars": 200,
    "text_suffixes": [
      ".md",
      ".txt"
    ]
  },
  "routes": {
    "list": {
      "method": "GET",
      "path": "/api/notes/list",
      "query": {
        "q": "optional text; case-insensitive; bounded"
      },
      "answer": {
        "status": 200,
        "body": {
          "ok": true,
          "root": "<absolute vault path, for display only>",
          "count": 1,
          "notes": [
            {
              "path": "Inbox/idea.md",
              "title": "idea",
              "size": 10,
              "mtime": 1761900000.0
            }
          ],
          "truncated": false
        },
        "note": "count is the rows in THIS answer, not the vault total; truncated says more exist"
      },
      "errors": {
        "503": {
          "ok": false,
          "error": "no Obsidian vault configured; the sentence names the setting"
        }
      }
    },
    "read": {
      "method": "GET",
      "path": "/api/notes/read",
      "query": {
        "path": "vault-relative .md/.txt path"
      },
      "answer": {
        "status": 200,
        "body": {
          "ok": true,
          "path": "Inbox/idea.md",
          "text": "hello note",
          "sha256": "f14258e49b025a58141c2ae9a231307934fc9f5e9d3939bb26dc08a4f9512a4d",
          "size": 10,
          "mtime": 1761900000.0
        }
      },
      "errors": {
        "400": {
          "ok": false,
          "error": "bad, absolute, outside, hidden, link or non-.md/.txt path"
        },
        "404": {
          "ok": false,
          "error": "there is no note at that path"
        },
        "413": {
          "ok": false,
          "error": "the note is over 2 MiB"
        },
        "503": {
          "ok": false,
          "error": "no Obsidian vault configured"
        }
      }
    },
    "save": {
      "method": "POST",
      "path": "/api/notes/save",
      "request": {
        "path": "Inbox/idea.md",
        "text": "hello note, edited",
        "expected_sha256": "f14258e49b025a58141c2ae9a231307934fc9f5e9d3939bb26dc08a4f9512a4d"
      },
      "answers": {
        "202": {
          "state": "waiting",
          "body": {
            "ok": true,
            "state": "waiting",
            "id": "<job id>",
            "path": "Inbox/idea.md"
          },
          "note": "the approval card is up; the write happens only after Approve"
        },
        "200": {
          "state": "saved",
          "body": {
            "ok": true,
            "state": "saved",
            "path": "Inbox/idea.md",
            "sha256": "0e4138cec6eafad102e2fe6731977802b9b455b01b42e225180c047a5bcc68b5"
          },
          "note": "only when a future config makes the action tier auto"
        },
        "409": {
          "state": "conflict",
          "body": {
            "ok": false,
            "state": "conflict",
            "path": "Inbox/idea.md",
            "current_sha256": "<hex of the current bytes>",
            "error": "the note changed since this edit started; nothing was written"
          },
          "note": "nothing written, no card raised"
        },
        "400": {
          "ok": false,
          "state": "refused",
          "error": "bad body or path; missing expected_sha256 or text"
        },
        "413": {
          "ok": false,
          "state": "refused",
          "error": "the new text is over 2 MiB"
        },
        "429": {
          "ok": false,
          "state": "refused",
          "error": "4 note saves are already waiting for approval - the sentence names the limit"
        },
        "503": {
          "ok": false,
          "state": "refused",
          "error": "no Obsidian vault configured"
        }
      }
    },
    "save_status": {
      "method": "GET",
      "path": "/api/notes/save",
      "query": {
        "id": "the id from a 202"
      },
      "answer": {
        "status": 200,
        "states": [
          "waiting",
          "saved",
          "denied",
          "failed"
        ],
        "body": {
          "ok": true,
          "state": "saved",
          "path": "Inbox/idea.md",
          "sha256": "0e4138cec6eafad102e2fe6731977802b9b455b01b42e225180c047a5bcc68b5",
          "message": "Saved Inbox/idea.md into your Obsidian vault."
        },
        "note": "ok is true only while waiting or after a save; sha256 is null in every other state"
      },
      "errors": {
        "404": {
          "ok": false,
          "state": "unknown",
          "error": "There is no note save with that id on this PC."
        }
      }
    }
  }
}
