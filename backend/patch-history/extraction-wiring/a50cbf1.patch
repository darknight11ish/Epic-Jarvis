+def _poll_proposals(bus: Bus) -> None:
+    """Facts the extractor would like to remember, waiting for a human.
+
+    The queue now fills on its own - a pass runs after a conversation goes
+    quiet - so nobody asked for the thing that is waiting. Without an event
+    the only way to find out is to open the memory pane and look, which means
+    the review queue grows unseen and the learning loop looks broken from
+    every surface at once.
+
+    A doorbell, like approvals: the count and the ids, never the text. A
+    proposal quotes whatever was said to produce it, and this bus reaches
+    every connected client, including a phone showing notifications on a lock
+    screen.
+    """
+    try:
+        import jarvis_extract
+        pending = jarvis_extract.pending()
+    except Exception:
+        return
+    ev = bus.note("proposals", sorted(int(p.get("id") or 0) for p in pending),
+                  "proposal")
+    if ev is not None:
+        ev.data.update({"count": len(pending)})
+
