+def _manual_lane(decide, chosen, local_model: str, lanes=None):
+    """(lane, reason, gate) for a lane the owner picked by hand - THE GATE.
+
+    Pure on purpose: it reads no module, no file and no request, so the rule
+    below is proved by calling it rather than by driving a running HUD
+    (`backend/test_hud_manual_lane_gate.py`).
+
+    A pick of `local_model` is exactly what it was before this existed: that
+    lane, gate "manual", memory riding along as on any local turn.
+
+    A pick of any OTHER lane is a pick of a CLOUD lane, and F-01 (2026-10-27)
+    is why it is not simply obeyed. `{"lane": "<cloud lane>", "auto": false}`
+    used to reach a cloud model with private memory text, a tainted
+    conversation, a picture or the owner's screen attached: the manual path
+    built its Decision itself and ran no gate at all. Such a pick is used
+    ONLY when `decide` - the decision this turn got from the ONE
+    jarvis_router.choose() call in do_POST, with the pick standing in for the
+    owner's yes - landed on a cloud lane (gate "escalate"). Everything the
+    router checks still runs first: the everyday model being one of Ollama's
+    cloud models, no lane offered, Lockdown, a tainted conversation, a
+    picture, the owner's screen, the private-topic backstop, a real secret,
+    the complexity threshold and the cloud budget. If any of them refuses, or
+    `lanes` (the lane names this PC actually offers) does not hold the chosen
+    name, or there is no router at all (`decide` is None), the turn stays on
+    the local model and `reason` says so in one plain sentence. Nothing here
+    can send a turn out "just because the owner picked the lane".
+
+    Returns the three values a Decision is built from, so no caller has to
+    re-derive the rule - and the tests can read the rule without a Decision.
+    """
+    local = str(local_model or "local")
+    pick = str(chosen or local)
+    # The client's own words go into a header: one line, short, printable, no
+    # control characters. Nothing else about the name is trusted (the
+    # membership test below is what decides), so a friendly label is all this
+    # is.
+    label = " ".join(
+        "".join(c if c.isprintable() else " " for c in pick).split())[:60]
+    if pick == local:
+        return local, "you chose this lane", "manual"
+    if decide is None:
+        return local, (f"you chose {label}, but this turn stays local: the "
+                       "routing module is not installed on this PC"), "unavailable"
+    if pick not in [str(n) for n in (lanes or [])]:
+        return local, (f"you chose {label}, but this turn stays local: this PC "
+                       "offers no cloud lane by that name"), "unavailable"
+    gate = str(getattr(decide, "gate", "") or "") or "manual"
+    if gate != "escalate" or str(getattr(decide, "lane", "") or "") == local:
+        if gate == "escalate":
+            # A cloud lane and this PC at once cannot happen; if it ever does,
+            # the header must not say "escalate" - the apps read that value as
+            # "the answer came from the cloud" on a backend without `where`.
+            gate = "manual"
+        why = " ".join(str(getattr(decide, "reason", "") or "").split())
+        return local, (f"you chose {label}, but this turn stays local: "
+                       f"{why or 'the router kept it on this machine'}"), gate
+    return pick, "you chose this lane", "manual"
+
+
+def _manual_decision(chosen: str, local_model: str, decide=None, lanes=None):
+    """You picked the lane yourself. Memory still only rides along locally.
+
+    `decide` is the decision this turn got from the ONE
+    jarvis_router.choose() call in do_POST, or None when there is no router
+    (`ROUTING` is False). `_manual_lane()` is the rule - a cloud pick is used
+    only when that decision landed on a cloud lane - and this function only
+    turns its answer into the Decision the rest of the turn reads. With no
+    router a cloud pick therefore stays local too, which is the fail-closed
+    direction: on its own this function cannot put a turn on a cloud lane.
+    """
+    picked, why, gate_name = _manual_lane(decide, chosen, local_model, lanes)
+    is_local = picked == str(local_model or "local")
