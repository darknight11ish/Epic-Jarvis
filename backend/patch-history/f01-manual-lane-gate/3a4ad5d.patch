+    # refused pick may name gate "complexity", and "complexity": 0.0 beside
+    # that sentence would contradict it. Without a router this keeps the 0.0
+    # the manual path has always reported.
+    complexity_of = 0.0
+    if decide is not None:
+        try:
+            complexity_of = float(getattr(decide, "complexity", 0.0) or 0.0)
+        except (TypeError, ValueError):
+            complexity_of = 0.0
     if ROUTING:
         return jarvis_router.Decision(
