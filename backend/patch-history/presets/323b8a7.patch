+# --------------------------------------------------------------------------
+#   The active chat lane (presets.patch, 2026-10-18)
+#
+#   The chat lane is chosen per request from ONE file, not from a module
+#   constant. No preset has ever been applied -> the file is absent and every
+#   URL below is exactly OLLAMA_URL, byte-for-byte the behaviour before this
+#   patch. A file naming a non-loopback address is ignored: this is a choice
+#   between LANES ON THIS PC, never a way to send chat off the machine.
+# --------------------------------------------------------------------------
+
+PRESETS_LANE_FILE = CONFIG_DIR / "presets-active-lane.json"
+
+
+def active_ollama_url() -> str:
+    """The chat lane's address, from the owner's applied preset; OLLAMA_URL when
+    there is no file (the default), the file is unreadable, or it names anything
+    that is not a loopback address. Never raises."""
+    try:
+        doc = json.loads(PRESETS_LANE_FILE.read_text(encoding="utf-8"))
+        url = str(doc.get("base_url") or "").strip().rstrip("/")
+    except Exception:
+        return OLLAMA_URL
+    if url.startswith(("http://127.0.0.1:", "http://localhost:")):
+        return url
+    return OLLAMA_URL
+
+
+def set_active_ollama_url(base_url: str) -> bool:
+    """Persist the lane the next chat request talks to. Written beside the
+    other settings, atomically; False (and nothing changed) on any error."""
+    url = str(base_url or "").strip().rstrip("/")
+    if not url.startswith(("http://127.0.0.1:", "http://localhost:")):
+        return False
+    try:
+        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
+        tmp = PRESETS_LANE_FILE.with_suffix(".json.tmp")
+        tmp.write_text(json.dumps({"base_url": url}, indent=2) + "\n", encoding="utf-8")
+        tmp.replace(PRESETS_LANE_FILE)
+        return True
+    except Exception:
+        return False
+
 FACTS_FILE = CONFIG_DIR / "memory_facts.jsonl"
