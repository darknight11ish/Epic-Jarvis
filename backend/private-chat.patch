+# private-chat.patch (2026-10-25, the architect's H10 ruling). A PRIVATE chat -
+# `"private": true` on the /api/chat request - is a temporary chat plus a strict
+# reads-only promise: it recalls nothing, learns nothing, keeps nothing AND
+# every disk write its turn would make is refused. The one gate and the one
+# refusal sentence live in the shipped jarvis_private_chat.py; every helper
+# here FAILS CLOSED - if that module is missing or broken, the strict one-line
+# test is still made and a private request is still refused, so a missing file
+# can never turn a private turn into an ordinary one. Everything that changes
+# something - a timer, a setting, a personality, a note, a tool that needs a
+# card - is refused in one plain sentence before it runs; a private chat runs
+# NO tool at all and its approval gate refuses anything the model still asks
+# for, so no approval row, undo receipt or tool output can be written either.
+# The route header says `"private": true`; /api/version's
+# capabilities.private_chat is true only when the running server has this
+# patch AND the shipped module (jarvis_events probes both). An ordinary chat is
+# exactly what it was.
+_PRIVATE_REFUSAL = ("A private chat can read, search, and answer, but it doesn't change "
+                    "settings, save items, or run actions — switch back to a normal chat "
+                    "to do that.")
+
+
+def _private_chat(body) -> bool:
+    """Is this /api/chat request a private chat? FAIL CLOSED: the canonical
+    reading is jarvis_private_chat.is_private (JSON `true`, nothing else), and
+    when that module cannot be imported the same one-line test is made here
+    rather than answering False."""
+    try:
+        import jarvis_private_chat
+        return bool(jarvis_private_chat.is_private(body))
+    except Exception:
+        return isinstance(body, dict) and body.get("private") is True
+
+
+def _private_refusal() -> str:
+    """The one refusal sentence: the shipped module's copy, or a byte-identical
+    fallback when it is missing (the suite asserts they are equal)."""
+    try:
+        import jarvis_private_chat
+        return jarvis_private_chat.REFUSAL
+    except Exception:
+        return _PRIVATE_REFUSAL
+
+
+def _persist_ok(kind: str, body) -> bool:
+    """The single fail-closed write gate: may this turn write `kind` to disk?
+
+    FALSE first whenever the body says private, whatever happened to the
+    module - that is the fail-closed half. Otherwise the shipped module's own
+    persist() answers (it refuses an unknown kind); with no module and no
+    private flag this is an ordinary chat, which writes as it always did."""
+    if _private_chat(body):
+        return False
+    try:
+        import jarvis_private_chat
+        return bool(jarvis_private_chat.persist(kind, body))
+    except Exception:
+        return True
+
+
+def _private_turn(cfg, body) -> bool:
+    """private-chat.patch: a private chat runs NO tool at all. Empties the
+    tools list both chat call sites below read, and answers whether this turn
+    is private. Stricter than refusing only the mutating/card-gated tools, and
+    that is what makes the zero-write promise provable: no tool means no
+    approval row, no undo receipt, no tool output kept or replayed."""
+    private = _private_chat(body)
+    if private:
+        cfg["tools"] = dict(cfg.get("tools") or {})
+        cfg["tools"]["enabled"] = []
+    return private
+
+
+def _private_gate(action, detail, prompt=""):
+    """private-chat.patch: NOTHING is approved in a private chat. Handed to the
+    agent's tool loop, this answers every `gate_check` call with a refusal and
+    never calls jarvis_gate - so no approvals row is written and no tool runs
+    (hence no undo receipt from a tool-based action either)."""
+    class _Refused:
+        allowed = False
+        tier = "ask"
+        outcome = "denied"
+        request_id = None
+
+        def __init__(self, reason):
+            self.reason = reason
+
+    return _Refused(_private_refusal())
+
+
 def _temporary_chat(body) -> bool:
