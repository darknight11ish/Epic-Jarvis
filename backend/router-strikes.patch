+def _note_local_failure(lane: str, local_model: str, conversation) -> None:
+    """Record ONE local relay failure for a conversation, and nothing else.
+
+    router-strikes.patch (2026-11-20, external review ruling 6.1's HUD half):
+    `jarvis_router.note_local_failure()` and `choose(conversation=, coding=)`
+    shipped in #1408, and NOTHING CALLED THEM. This is the relay's own
+    local-failure point: a turn the local model could not answer was recorded
+    here, so the THIRD attempt at a coding turn in the same conversation may
+    reach a cloud lane under 0.40 - after every safety gate has still run, and
+    still only with the owner's yes / this PC's standing switch.
+
+    A cloud lane is never recorded: only a local attempt that produced no
+    usable answer is evidence about the local model. Nothing is decided here,
+    nothing is sent, and only the conversation id is kept - `jarvis_router`
+    stores a count, never a word.
+    """
+    if lane != local_model:
+        return
+    try:
+        import jarvis_router
+        jarvis_router.note_local_failure(conversation)
+    except Exception:
+        pass
+
+
+def _clear_local_failures(lane: str, local_model: str, conversation) -> None:
+    """A local turn really produced an answer: forget its conversation's count.
+
+    router-strikes.patch (2026-11-20, ruling 6.1). Two failures are evidence
+    the local model cannot answer a coding question; a later success is
+    evidence it can answer THIS conversation again, so the count starts over.
+    A cloud lane clears nothing, and a failure never clears anything.
+    """
+    if lane != local_model:
+        return
+    try:
+        import jarvis_router
+        jarvis_router.reset_local_failures(conversation)
+    except Exception:
+        pass
+
