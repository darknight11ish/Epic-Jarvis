+# --------------------------------------------------------------------------
+#   A standing approval that covered one action (the owner's ask, 2026-11-01)
+# --------------------------------------------------------------------------
+#
+# A conversation-scoped web-search approval is kept in jarvis_agent.py, because
+# the CONVERSATION ID lives there: it arrives on the chat request, and this
+# module is never handed one - it decides one action at a time and knows
+# nothing about a chat. What belongs HERE is the record. While a grant is live
+# the owner sees no card, so this log is the only evidence that a search ran
+# unasked, and under which grant.
+#
+# Three events, written by jarvis_agent through the three functions below
+# rather than by calling audit_log() itself: the event names and the redaction
+# rules are this module's. They are additive, and a backend whose jarvis_agent
+# is newer than this file finds no such function and refuses to create a grant
+# at all (jarvis_agent._grant_audit) rather than letting searches run that
+# nobody logged.
+
+def grant_made(grant_id: str, seconds: float = 0) -> None:
+    """ONE approval card was approved: web searches in one conversation now run
+    without a card until the owner stops it, that chat ends, `seconds` pass or
+    this PC restarts. The conversation itself is never written down - `grant`
+    is this process's own random id, and the grant dies with the process."""
+    _audit("gate.grant_made", {"grant": grant_id, "seconds": seconds})
+
+
+def granted(action: str, grant_id: str) -> None:
+    """One action a standing approval covered, so no card was shown for it.
+
+    Called by jarvis_agent's `_web_search_call` for `search_the_web` only, and
+    only for a search that is about to run - a search that starts is a search
+    that happened, whatever comes back."""
+    _audit("gate.granted", {"action": action, "grant": grant_id})
+
+
+def grant_ended(grant_id: str, state: str = "") -> None:
+    """A standing approval stopped covering anything: the owner said so
+    (`state` "revoked"), or its cap ran out (`state` "expired"). Nothing runs
+    differently because of this line; it is the record of when it stopped."""
+    _audit("gate.grant_ended", {"grant": grant_id, "state": state})
 
 
