+
+    open(os.path.join(TMP, "approved-4.json"), "w").write("{not json")
+    g = Gate()
+    b = bridge(gate=g, approvals=M.ApprovalStore(os.path.join(TMP, "approved-4.json")))
+    res = b.start("fake")
+    check("a damaged approvals file asks again", res["ok"] and len(g.calls) == 1, res)
+    b.shutdown()
+
+
