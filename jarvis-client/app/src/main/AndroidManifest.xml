<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Reading phone notifications (data/NotificationAllowListStore.kt
         `installedApps()`): without this, Android 11+'s package-visibility
         rules would quietly filter `PackageManager.getInstalledApplications`
         down to almost nothing, so the "add an app" picker would show few
         or none of the apps actually on the phone - not a security
         boundary this app needs to ask around, since the owner is choosing
         from apps already on their own device, by name, the same as they
         could in their own phone's Settings -> Apps list. Declaring every
         app with an ordinary home-screen icon as queryable is the
         documented, minimal way to do that: it does NOT grant
         QUERY_ALL_PACKAGES (which needs a Play Store declaration this
         non-commercial, sideloaded app has no path to make), and it grants
         no capability beyond seeing that a package with a launcher icon
         exists and its label - nothing this app could not already learn a
         different way once "Notification access" (§61) is granted, since
         that already hands over every posted notification's package name
         regardless of this element. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Telephony.Sms.getDefaultSmsPackage (§61's SMS exclusion,
             NotificationAllowListStore.kt / PhoneNotificationListenerService
             .kt): Android 11+ package visibility hides which app answers
             this without declaring the intent action its own contract is
             built on, even though no special runtime permission is needed
             to ask the question itself. -->
        <intent>
            <action android:name="android.provider.Telephony.SMS_DELIVER" />
        </intent>
    </queries>

    <!-- "Also on my phone" (2026-09-26): the owner's tap hands an alarm to the
         phone's own Clock app (AlarmClock.ACTION_SET_ALARM), which needs this
         install-time permission. The Clock app shows its own screen and the
         owner saves it there; this app sets no alarm of its own, and asks
         for no exact-alarm permission. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- §3.1(2). specialUse is uncapped; dataSync is not. See strings.xml. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- §3.1(3). Runtime grant since API 33. Denied, the service still runs but
         its ongoing notification is hidden from the drawer, which is exactly
         the state step 8's live-state notification depends on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Push-to-talk. Requested at the moment the microphone is first held,
         never at launch: a permission dialog on first run, before the app has
         shown what it is for, is the one most people refuse. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Reading the pairing QR code on the PC (docs/PAIRING-DESIGN.md §8.3,
         ui/screens/QrScanScreen.kt). Asked for only when the owner taps
         "Scan the code on your PC", after one sentence saying why; refused,
         the owner types the code instead. Nothing is recorded or sent. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not required: a phone without a camera still installs, and pairs by
         typing the code. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- "Hey Jarvis" on this phone (WakeWordService). Listening with the
         screen off or the app in the background needs a foreground service
         of type microphone, and on Android 14+ this permission with it.
         Only ever started from the app's own Checks screen (or the app
         itself, opened by the owner's tap on the one "tap to turn it back
         on" notice after a restart - data/WakeResume.kt), never at boot;
         Android shows the microphone indicator for as long as it runs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- "Interrupt Jarvis while it talks" (Speaker.beginVoiceCall): the reply
         plays in voice-call mode so Android's echo canceller can take it back
         out of the microphone. Switching the audio mode and the call's output
         device needs this. A normal permission (granted at install, no
         dialog) that allows changing the phone's audio settings; the app
         uses it only here, and puts the mode back when Jarvis stops. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- The Overlay path of "Floating Jarvis" (data/FloatingAvatar.kt,
         service/AvatarOverlayService.kt): the small draggable window drawn
         on top of every other app. This is a manifest declaration, not the
         grant itself - the grant is `Settings.canDrawOverlays`, a special
         app-access toggle only the owner can flip, in Android's own
         "draw over other apps" screen, which `FloatingAvatarPlate.kt`
         explains in plain words before ever opening it. Requested only when
         the owner picks Overlay, never at launch and never for Bubble. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The service returns START_STICKY, and a sticky restart happens with the app
         in the background - which is not on the FGS background-start exemption list,
         so startForeground throws and the link ends permanently. A battery-optimisation
         exemption is the exemption that covers it. Requested from the readiness
         screen, never silently. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- So the link comes back after a reboot rather than waiting for the user to
         open the app. BOOT_COMPLETED is itself an explicit FGS start exemption. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 14+'s back-swipe preview. NavBackHandler already goes
         through Compose's own BackHandler, which supports predictive back
         the moment the platform is told this app wants it; without this
         flag the platform withholds the preview and back stays a hard cut
         regardless of what the app itself does. -->
    <application
        android:name=".JarvisApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <!-- resizeableActivity: recommended for the Activity a chat
                 bubble expands into ("Floating Jarvis: Bubble",
                 service/WakeWordService.kt's attachBubble) - the bubble's
                 floating window resizes this same Activity rather than a
                 second, cut-down one. Harmless with Floating Jarvis off. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App-icon shortcuts (feasibility I125): Talk, Note, Brief me,
                 What did I miss - res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- "Share" from another app - a web page's selected text, a
                 note, an address - lands here as plain text and is folded
                 into the composer draft, never sent on its own. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- One photo shared from another app (Gallery, the camera, a
                 screenshot). Attached to the next question under the Photo
                 button's own rule - only while the PC says Pictures on the
                 second graphics card works, and shrunk to the same limits
                 (ChatPicture, PictureEncoder). When Pictures is off the share
                 still opens Jarvis, and Home says in words why the photo was
                 not attached: it is never silently dropped. Never sent on its
                 own - the owner types the question and taps Send. One image
                 only: SEND, not SEND_MULTIPLE. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Makes this app a candidate for the older, plain-intent style
                 of Settings -> Apps -> Default apps -> Digital assistant app
                 some OEMs still use. Picking Jarvis here just means a
                 long-press of the home button, or the assist gesture, opens
                 this activity like any other launch. Nothing about what
                 happens once it opens changes - that is true of this
                 intent-filter and of the RoleManager path below alike; see
                 JarvisVoiceInteractionSession's own doc for why. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The newer path: RoleManager.ROLE_ASSISTANT, which some launchers
             offer the assist gesture to exclusively rather than to anything
             with a plain ACTION_ASSIST intent-filter. The assistant role adds
             no listening of its own (the only always-on listening is
             WakeWordService, switched on separately, and it spots one phrase
             and recognises no words) - JarvisRecognitionServiceStub recognises
             nothing and JarvisVoiceInteractionSession does nothing but open
             MainActivity - so "rule: no client-side speech-to-text" still
             holds exactly as it did with the plain intent-filter alone.
             android:exported must be true: RoleManager and the assist
             gesture both bind to this from outside this app's own process,
             the BIND_VOICE_INTERACTION permission is what keeps that bind
             restricted to the system. -->
        <service
            android:name=".assistant.JarvisVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <service
            android:name=".assistant.JarvisVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- The recognitionService voice_interaction_service.xml names -
             required by that schema, never actually invoked by anything in
             this app. See JarvisRecognitionServiceStub's own doc.

             DELIBERATELY NO intent-filter. It had one, and that was a bug
             with the blast radius of the whole phone: the filter is what put
             this always-failing stub into the system's list of candidate
             speech recognisers, where picking it (or the system falling back
             to it) breaks SpeechRecognizer for every app on the device. It
             was never needed - VoiceInteractionServiceInfo resolves this
             component from the `recognitionService` attribute string in
             voice_interaction_service.xml and never queries by action. The
             matching selectableAsDefault="false" is in that file; both
             halves are required, since either alone still leaves a route in.

             exported stays true: the system binds this by explicit component
             from outside this app's process, and BIND_RECOGNITION_SERVICE is
             what keeps that bind restricted to the system. -->
        <service
            android:name=".assistant.JarvisRecognitionServiceStub"
            android:exported="true"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- Not a power tile. The desktop CAN set power mode now (POST /api/power,
             power-mode.patch; the phone's Mind screen has the buttons), but the
             answer is often not "done": waking is held on a stale link, and the
             desktop decides through its approval gate (power_manage). A tile has
             nowhere to say that, and a tile that appeared to switch Jarvis to
             Quiet and silently did not would be worse than no tile. This one
             carries the link's real state and mutes spoken interruptions, which
             /api/attention/mute supports. -->
        <service
            android:name=".service.LinkTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Reading phone notifications (CLAUDE.md, 2026-09-26; built
             2026-09-28; service/PhoneNotificationListenerService.kt). This
             declaration alone grants nothing - the owner still has to turn
             it on by hand, in Android's own "Notification access" screen
             (Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS), which
             PhoneNotificationsPlate.kt explains in plain words first, the
             same pattern as SYSTEM_ALERT_WINDOW above. Bound is the whole
             point of BIND_NOTIFICATION_LISTENER_SERVICE: only the system
             may connect to it, exported="false" narrows that further so no
             other app can even try. Jarvis's OWN switch
             (phone_notifications_read, off by default) and its own per-app
             allow list (empty by default) still gate everything this
             service actually stores, on top of this OS-level grant. -->
        <service
            android:name=".service.PhoneNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- "Quick Settings tiles you choose" (data/QuickTiles.kt,
             service/QuickTileService.kt; docs/JARVIS-API.md section 81.2).
             Android cannot add a tile at run time, so three fixed slots;
             the owner picks each one's action in Settings -> Quick Settings
             tiles, from a short safe list that never includes Approve or
             Deny. Exported with BIND_QUICK_SETTINGS_TILE, exactly like
             LinkTileService above: only the system can bind them. -->
        <service
            android:name=".service.QuickTileOneService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_slot_1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".service.QuickTileTwoService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_slot_2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".service.QuickTileThreeService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_slot_3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- exported="false" and it still receives BOOT_COMPLETED: that broadcast
             and MY_PACKAGE_REPLACED are both protected system broadcasts, which the
             system delivers to an app's own receivers regardless. Exporting it only
             ever let OTHER apps address this receiver directly, and all they could
             make it do is start the link - low impact, but free to close. -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.EventService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/fgs_special_use_reason" />
        </service>
        <!-- Its own service and its own type, not "specialUse|microphone" on
             the link: the event stream must keep running when listening is
             switched off, and listening must be stoppable on its own
             (docs/WAKE-WORD.md §4 step 1). -->
        <service
            android:name=".service.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Jarvis Live on this phone (service/LiveService.kt;
             docs/LIVE-DESIGN.md): the microphone while a Live conversation
             the owner started is on, and only then. Started from the app's
             own Live screen (or its "let's talk" reply), never at boot;
             START_NOT_STICKY; its notification stays on this phone and has
             End and Mute. Calls are noticed from the audio mode - no phone
             permission is asked for. -->
        <service
            android:name=".service.LiveService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The Overlay path of "Floating Jarvis" (data/FloatingAvatar.kt).
             specialUse, not any of the other types: it holds a window, not
             the microphone (WakeWordService already has that, separately,
             while "Listen on this phone" is on) and no data of its own -
             see §3.1(2)'s reasoning for specialUse over dataSync, which
             applies here too. Its own subtype string, since a service's
             PROPERTY_SPECIAL_USE_FGS_SUBTYPE describes only that service. -->
        <service
            android:name=".service.AvatarOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/fgs_avatar_overlay_reason" />
        </service>

        <!-- exported="true" is what every app-widget provider needs - the
             launcher itself is what sends APPWIDGET_UPDATE, from outside this
             app's own process, and cannot be addressed otherwise. Redrawn by
             JarvisRuntime's own state changes, never by a polling clock -
             updatePeriodMillis is 0 in widget_approval_info.xml. -->
        <receiver
            android:name=".widget.ApprovalWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_approval_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_approval_info" />
        </receiver>

        <!-- Same reasoning as ApprovalWidgetReceiver above: the launcher
             addresses this from outside this app's own process. -->
        <receiver
            android:name=".widget.QuickLinkWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quicklink_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quicklink_info" />
        </receiver>

        <!-- "Jarvis widget" 1-3 (docs/JARVIS-API.md section 86): each draws
             the saved widget the owner gave its slot under Brain, Widgets.
             Three fixed receivers, like the three Quick Settings tile slots:
             Android cannot add a widget type while the app runs. Exported
             for the same reason as the two above. -->
        <receiver
            android:name=".widget.JarvisBoardWidgetOneReceiver"
            android:exported="true"
            android:label="@string/widget_board_name_1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_board_info" />
        </receiver>
        <receiver
            android:name=".widget.JarvisBoardWidgetTwoReceiver"
            android:exported="true"
            android:label="@string/widget_board_name_2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_board_info" />
        </receiver>
        <receiver
            android:name=".widget.JarvisBoardWidgetThreeReceiver"
            android:exported="true"
            android:label="@string/widget_board_name_3">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_board_info" />
        </receiver>
    </application>
</manifest>
