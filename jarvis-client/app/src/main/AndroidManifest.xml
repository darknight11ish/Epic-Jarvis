<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- "Also on my phone" (2026-09-26): the owner's tap hands an alarm to the
         phone's own Clock app (AlarmClock.ACTION_SET_ALARM), which needs this
         install-time permission. The Clock app shows its own screen and the
         owner saves it there; this app sets no alarm of its own, and asks
         for no exact-alarm permission. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- §3.1(2). specialUse is uncapped; dataSync is not. See strings.xml. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- §3.1(3). Runtime grant since API 33. Denied, the service still runs but
         its ongoing notification is hidden from the drawer, which is exactly
         the state step 8's live-state notification depends on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Push-to-talk. Requested at the moment the microphone is first held,
         never at launch: a permission dialog on first run, before the app has
         shown what it is for, is the one most people refuse. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- "Hey Jarvis" on this phone (WakeWordService). Listening with the
         screen off or the app in the background needs a foreground service
         of type microphone, and on Android 14+ this permission with it.
         Only ever started from the app's own Checks screen, never at boot;
         Android shows the microphone indicator for as long as it runs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- "Interrupt Jarvis while it talks" (Speaker.beginVoiceCall): the reply
         plays in voice-call mode so Android's echo canceller can take it back
         out of the microphone. Switching the audio mode and the call's output
         device needs this. A normal permission (granted at install, no
         dialog) that allows changing the phone's audio settings; the app
         uses it only here, and puts the mode back when Jarvis stops. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- The service returns START_STICKY, and a sticky restart happens with the app
         in the background - which is not on the FGS background-start exemption list,
         so startForeground throws and the link ends permanently. A battery-optimisation
         exemption is the exemption that covers it. Requested from the readiness
         screen, never silently. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- So the link comes back after a reboot rather than waiting for the user to
         open the app. BOOT_COMPLETED is itself an explicit FGS start exemption. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 14+'s back-swipe preview. NavBackHandler already goes
         through Compose's own BackHandler, which supports predictive back
         the moment the platform is told this app wants it; without this
         flag the platform withholds the preview and back stays a hard cut
         regardless of what the app itself does. -->
    <application
        android:name=".JarvisApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Share" from another app - a web page's selected text, a
                 note, an address - lands here as plain text and is folded
                 into the composer draft, never sent on its own. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- One photo shared from another app (Gallery, the camera, a
                 screenshot). Attached to the next question under the Photo
                 button's own rule - only while the PC says Pictures on the
                 second graphics card works, and shrunk to the same limits
                 (ChatPicture, PictureEncoder). When Pictures is off the share
                 still opens Jarvis, and Home says in words why the photo was
                 not attached: it is never silently dropped. Never sent on its
                 own - the owner types the question and taps Send. One image
                 only: SEND, not SEND_MULTIPLE. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Makes this app a candidate for the older, plain-intent style
                 of Settings -> Apps -> Default apps -> Digital assistant app
                 some OEMs still use. Picking Jarvis here just means a
                 long-press of the home button, or the assist gesture, opens
                 this activity like any other launch. Nothing about what
                 happens once it opens changes - that is true of this
                 intent-filter and of the RoleManager path below alike; see
                 JarvisVoiceInteractionSession's own doc for why. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The newer path: RoleManager.ROLE_ASSISTANT, which some launchers
             offer the assist gesture to exclusively rather than to anything
             with a plain ACTION_ASSIST intent-filter. The assistant role adds
             no listening of its own (the only always-on listening is
             WakeWordService, switched on separately, and it spots one phrase
             and recognises no words) - JarvisRecognitionServiceStub recognises
             nothing and JarvisVoiceInteractionSession does nothing but open
             MainActivity - so "rule: no client-side speech-to-text" still
             holds exactly as it did with the plain intent-filter alone.
             android:exported must be true: RoleManager and the assist
             gesture both bind to this from outside this app's own process,
             the BIND_VOICE_INTERACTION permission is what keeps that bind
             restricted to the system. -->
        <service
            android:name=".assistant.JarvisVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <service
            android:name=".assistant.JarvisVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- The recognitionService voice_interaction_service.xml names -
             required by that schema, never actually invoked by anything in
             this app. See JarvisRecognitionServiceStub's own doc.

             DELIBERATELY NO intent-filter. It had one, and that was a bug
             with the blast radius of the whole phone: the filter is what put
             this always-failing stub into the system's list of candidate
             speech recognisers, where picking it (or the system falling back
             to it) breaks SpeechRecognizer for every app on the device. It
             was never needed - VoiceInteractionServiceInfo resolves this
             component from the `recognitionService` attribute string in
             voice_interaction_service.xml and never queries by action. The
             matching selectableAsDefault="false" is in that file; both
             halves are required, since either alone still leaves a route in.

             exported stays true: the system binds this by explicit component
             from outside this app's process, and BIND_RECOGNITION_SERVICE is
             what keeps that bind restricted to the system. -->
        <service
            android:name=".assistant.JarvisRecognitionServiceStub"
            android:exported="true"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- Not a power tile. The desktop CAN set power mode now (POST /api/power,
             power-mode.patch; the phone's Mind screen has the buttons), but the
             answer is often not "done": waking is held on a stale link, and the
             desktop decides through its approval gate (power_manage). A tile has
             nowhere to say that, and a tile that appeared to switch Jarvis to
             Quiet and silently did not would be worse than no tile. This one
             carries the link's real state and mutes spoken interruptions, which
             /api/attention/mute supports. -->
        <service
            android:name=".service.LinkTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- exported="false" and it still receives BOOT_COMPLETED: that broadcast
             and MY_PACKAGE_REPLACED are both protected system broadcasts, which the
             system delivers to an app's own receivers regardless. Exporting it only
             ever let OTHER apps address this receiver directly, and all they could
             make it do is start the link - low impact, but free to close. -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.EventService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/fgs_special_use_reason" />
        </service>
        <!-- Its own service and its own type, not "specialUse|microphone" on
             the link: the event stream must keep running when listening is
             switched off, and listening must be stoppable on its own
             (docs/WAKE-WORD.md §4 step 1). -->
        <service
            android:name=".service.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- exported="true" is what every app-widget provider needs - the
             launcher itself is what sends APPWIDGET_UPDATE, from outside this
             app's own process, and cannot be addressed otherwise. Redrawn by
             JarvisRuntime's own state changes, never by a polling clock -
             updatePeriodMillis is 0 in widget_approval_info.xml. -->
        <receiver
            android:name=".widget.ApprovalWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_approval_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_approval_info" />
        </receiver>

        <!-- Same reasoning as ApprovalWidgetReceiver above: the launcher
             addresses this from outside this app's own process. -->
        <receiver
            android:name=".widget.QuickLinkWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quicklink_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quicklink_info" />
        </receiver>
    </application>
</manifest>
