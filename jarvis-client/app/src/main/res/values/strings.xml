<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Jarvis</string>

    <!-- App-icon shortcuts (feasibility I125, docs/FEASIBILITY-AUDIT-
         2026-09-26.md: "Talk, Note, Brief me, What did I miss; still meets
         App lock"), shown on a long press of the app's own icon on the
         home screen or app drawer - res/xml/shortcuts.xml. Talk and Note
         reuse the widget's own buttons' actions; "Brief me now" and "What
         did I miss?" ask that sentence on Home as a typed question
         (AppShortcuts.kt holds the exact sentences, both from the "Things
         you can say" list). All four still open behind App lock like any other
         launch - MainActivity.kt's own "the app lock outranks everything"
         composes nothing else until it is unlocked. -->
    <string name="shortcut_talk_short">Talk</string>
    <string name="shortcut_talk_long">Talk to Jarvis</string>
    <string name="shortcut_live_short">Live</string>
    <string name="shortcut_live_long">Jarvis Live</string>
    <string name="shortcut_note_short">Note</string>
    <string name="shortcut_note_long">Quick note</string>
    <string name="shortcut_brief_short">Brief me</string>
    <string name="shortcut_brief_long">Brief me now</string>
    <!-- Short label kept close to Android's own ~10-character guidance for
         a shortcut's short label (the long label, shown with more room, is
         the full question); "Talk"/"Note"/"Brief me" already fit within it. -->
    <string name="shortcut_missed_short">Missed?</string>
    <string name="shortcut_missed_long">What did I miss?</string>

    <!--
      §3.1(2). specialUse, not dataSync. dataSync is capped at six hours per
      rolling 24h on Android 15; when the budget runs out the system calls
      onTimeout() and then throws a fatal RemoteServiceException. For an
      assistant meant to be there when you speak to it that is a crash on a
      timer, not a limitation.

      The usual cost of specialUse is a Play Console justification review. This
      APK is sideloaded, never listed and non-commercial, so that cost does not
      apply here.
    -->
    <string name="fgs_special_use_reason">Holds the live event connection to the
        user\'s own Jarvis backend, running on their own machine, so approval
        requests arrive while the screen is off.</string>

    <string name="channel_link_name">Jarvis link</string>
    <string name="channel_link_desc">Ongoing connection to your Jarvis backend.</string>
    <string name="channel_approval_name">Approvals</string>
    <string name="channel_approval_desc">A decision is waiting. This channel makes
        a sound: it is the only thing that tells you an approval arrived while the
        app was closed.</string>
    <string name="channel_approval_quiet_name">Approvals (quiet)</string>
    <string name="channel_approval_quiet_desc">Approvals that can be undone and stay
        on your desktop, and approvals raised only because a message tried to hurry
        you. Shown without a sound.</string>
    <string name="channel_alarm_name">Alarms and urgent alerts</string>
    <string name="channel_alarm_desc">An alarm, or a "tell me when" you marked urgent.
        Rings and vibrates until you look. It uses the alarm sound, so Do Not Disturb
        lets it through if your phone allows alarms then.</string>
    <string name="approval_locked">A decision is waiting. Unlock to see it.</string>
    <string name="approvals_waiting">%1$d approvals waiting</string>
    <string name="approval_deny_action">Deny</string>

    <string name="widget_approval_name">Jarvis approvals</string>
    <string name="widget_approval_desc">The oldest pending approval, at a glance.
        Deny answers it directly; approving always opens the app.</string>

    <!-- "Hey Jarvis" on this phone (service/WakeWordService.kt). -->
    <string name="channel_wake_name">Listening for \"hey Jarvis\"</string>
    <string name="channel_wake_desc">Shown for as long as this phone listens for
        \"hey Jarvis\". The microphone is open the whole time.</string>
    <string name="wake_listening_title">Listening for \"hey Jarvis\"</string>
    <string name="wake_listening_text">The microphone is open. Nothing leaves this phone
        until it hears \"hey Jarvis\" - then only what you say next goes to your PC.</string>
    <string name="wake_heard_text">Heard \"hey Jarvis\" - listening to what you say next.</string>
    <string name="wake_stop">Stop listening</string>

    <string name="widget_quicklink_name">Jarvis quick link</string>
    <string name="widget_quicklink_desc">The link status, and a one-tap Talk button that opens the
        app with the hold-to-talk mic ready - it does not record from the widget itself.</string>

    <!-- "Floating Jarvis": Overlay (data/FloatingAvatar.kt, service/AvatarOverlayService.kt). -->
    <string name="fgs_avatar_overlay_reason">Draws the small "Floating Jarvis" avatar
        the owner turned on, over other apps, so it stays reachable by voice
        without switching back to Jarvis.</string>
    <string name="channel_avatar_name">Floating Jarvis</string>
    <string name="channel_avatar_desc">Shown for as long as the floating avatar is on
        screen.</string>
    <string name="avatar_overlay_title">Floating Jarvis</string>
    <string name="avatar_overlay_text">The small avatar is on your screen. Tap "Turn off"
        below, or turn "Floating Jarvis" off in Settings.</string>
    <string name="avatar_overlay_stop">Turn off</string>

    <!-- The Jarvis Live extras (2026-09-28): the Quick Settings tile, and the
         second Share entry (activity-alias ShareToLive). -->
    <string name="live_tile_label">Jarvis Live</string>
    <string name="share_to_live_label">Talk about this in Live</string>
</resources>
