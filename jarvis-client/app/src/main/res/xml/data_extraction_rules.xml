<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of this app leaves the phone through Android's backup or
  phone-to-phone transfer (apps security audit L8).

  android:allowBackup="false" in the manifest stops cloud backup, but on
  Android 12 and newer it does NOT stop a device-to-device transfer (setting
  up a new phone from the old one). Without these rules that transfer could
  copy the PC's address, the settings and last-crash.txt to the new phone.
  The pairing token itself would be useless there - it is encrypted with a
  Keystore key that never leaves this phone - but none of it should move.

  "root" is the app's whole data folder; the other domains are inside it and
  are listed as well so nothing depends on how one domain nests in another.
  This app keeps nothing in device-protected or external storage.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
