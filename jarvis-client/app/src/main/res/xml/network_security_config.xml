<?xml version="1.0" encoding="utf-8"?>
<!--
  §3.1(1). Cleartext is off by default for targetSdk 28+, and this app speaks
  plain HTTP to a backend on a private mesh network. With no config the
  connection fails looking like a network error, not a policy one.

  The config wins over android:usesCleartextTraffic on API 24+, so the manifest
  flag is omitted entirely rather than set and silently ignored.

  Hostname route, per the brief's own preference. `ts.net` with subdomains
  covers every Tailscale MagicDNS name without the build needing to know which
  one, which is what makes this work for a host the user types at run time.
  `nord` does the same job for NordVPN Meshnet's own automatic per-device
  name (the `<something>.nord` "Nord Name" it assigns on pairing) - a second
  mesh product with the same shape: a name the user types at run time, not
  one the build can know in advance.

  What this deliberately does NOT cover: a bare 100.x.y.z or a 192.168.x.y
  typed as digits, regardless of which mesh product produced it - Tailscale
  and Meshnet both hand out addresses in the same CGNAT block. A network
  security config matches hostname strings and cannot express a CIDR range,
  so covering that block would mean listing four million literals. Pair by
  name instead - which also survives the address changing. The app says so
  when the host it is given cannot be reached in cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
        <domain includeSubdomains="true">nord</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
