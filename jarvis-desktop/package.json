{
  "name": "jarvis-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Jarvis Desktop — native Windows 11 spotlight client for the Jarvis stack (Tauri v2 + WebView2).",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "bundle:msi": "tauri build --bundles msi",
    "bundle:nsis": "tauri build --bundles nsis",
    "icons": "tauri icon src-tauri/icons/icon.png",
    "info": "tauri info",
    "fmt": "cd src-tauri && cargo fmt",
    "lint": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "check": "cd src-tauri && cargo check",
    "tauri": "tauri",
    "test": "cd src-tauri && cargo test"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
