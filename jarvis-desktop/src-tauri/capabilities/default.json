{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions granted to the Jarvis quickbar (spotlight) and the HUD window: window management, global shortcuts, clipboard access and desktop notifications.",
  "windows": ["quickbar", "hud"],
  "remote": {
    "urls": ["http://127.0.0.1:4719", "http://localhost:4719"]
  },
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "core:app:allow-name",
    "core:app:allow-tauri-version",
    "core:event:default",
    "core:webview:allow-internal-toggle-devtools",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-center",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-always-on-top",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-clear",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission"
  ]
}
