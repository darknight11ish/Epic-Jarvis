{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis Desktop",
  "version": "0.2.0",
  "identifier": "com.jarvis.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "quickbar",
        "title": "Jarvis",
        "url": "index.html",
        "width": 750,
        "height": 80,
        "minWidth": 750,
        "maxWidth": 750,
        "minHeight": 80,
        "maxHeight": 720,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "shadow": false,
        "focus": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "theme": "Dark"
      },
      {
        "label": "widget",
        "title": "Jarvis Desktop Widget",
        "url": "widget.html",
        "width": 320,
        "height": 44,
        "minWidth": 320,
        "maxWidth": 320,
        "minHeight": 44,
        "maxHeight": 400,
        "x": 40,
        "y": 40,
        "center": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "dragDropEnabled": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4719 http://localhost:4719; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "darknight11ish",
    "copyright": "Copyright (c) 2026 darknight11ish",
    "category": "Productivity",
    "shortDescription": "Jarvis, a private assistant that runs on your own PC.",
    "longDescription": "Jarvis Desktop is the Windows app for Jarvis, a personal assistant whose AI model runs on your own PC: a quick bar on Alt+Space, chat, voice, approvals, and the Brain window for memory, models and settings. Nothing private leaves your PC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "compression": "lzma"
      }
    },
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../../LICENSE": "LICENSE.txt"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/darknight11ish/Epic-Jarvis/releases/download/desktop-latest/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
