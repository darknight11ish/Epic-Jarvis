  "pattern_kinds": [
    "solid",
    "hue_sweep",
    "step_cycle",
    "breathe",
    "pulse",
    "gradient",
    "comet",
    "flicker",
    "reactive",
    "temperature",
    "strobe"
  ],
  "patterns": [
    {
      "id": "solid",
      "name": "Solid",
      "kind": "solid",
      "desc": "One colour, held. The quiet default.",
      "params": {
        "color": "ice-4"
      }
    },
    {
      "id": "rainbow",
      "name": "Rainbow",
      "kind": "hue_sweep",
      "desc": "Full hue circle, continuously. Reads as 'working hard' without any text.",
      "params": {
        "period_s": 6.0,
        "sat": 0.82,
        "light": 0.62,
        "span_deg": 360,
        "offset_deg": 0
      }
    },
    {
      "id": "cycle",
      "name": "Cycle",
      "kind": "step_cycle",
      "desc": "Steps through chosen palette colours, holding each. Discrete, not a blend.",
      "params": {
        "colors": [
          "ice-4",
          "violet-4",
          "amber-4",
          "verdant-4"
        ],
        "hold_s": 2.0,
        "blend_s": 0.45
      }
    },
    {
      "id": "breathe",
      "name": "Breathe",
      "kind": "breathe",
      "desc": "One colour, brightness rising and falling. Alive but resting.",
      "params": {
        "color": "ice-4",
        "period_s": 4.5,
        "depth": 0.45
      }
    },
    {
      "id": "pulse",
      "name": "Pulse",
      "kind": "pulse",
      "desc": "A single sharp beat, then dark. A turn signal, not a strobe.",
      "params": {
        "color": "amber-4",
        "period_s": 1.8,
        "sharpness": 9.0
      }
    },
    {
      "id": "gradient",
      "name": "Gradient",
      "kind": "gradient",
      "desc": "Slides back and forth between two colours.",
      "params": {
        "from": "azure-4",
        "to": "magenta-4",
        "period_s": 7.0
      }
    },
    {
      "id": "sweep",
      "name": "Sweep",
      "kind": "hue_sweep",
      "desc": "Rainbow with the leash on \u2014 a narrow hue band instead of the whole circle.",
      "params": {
        "period_s": 5.0,
        "sat": 0.7,
        "light": 0.6,
        "span_deg": 90,
        "offset_deg": 180
      }
    },
    {
      "id": "comet",
      "name": "Comet",
      "kind": "comet",
      "desc": "A bright head dragging a dim tail around the face.",
      "params": {
        "color": "ice-5",
        "tail": "ice-1",
        "period_s": 2.4
      }
    },
    {
      "id": "flicker",
      "name": "Flicker",
      "kind": "flicker",
      "desc": "Irregular drift within one family, like a filament or a fire.",
      "params": {
        "family": "ember",
        "rate_hz": 7.0,
        "depth": 0.55
      }
    },
    {
      "id": "reactive",
      "name": "Reactive",
      "kind": "reactive",
      "desc": "Colour follows your voice \u2014 quiet is cool, loud is hot.",
      "params": {
        "quiet": "azure-3",
        "loud": "rose-4",
        "gain": 1.6
      }
    },
    {
      "id": "temperature",
      "name": "Temperature",
      "kind": "temperature",
      "desc": "Cool to hot by how busy it is. Reads like a gauge.",
      "params": {
        "cold": "ice-2",
        "warm": "amber-4",
        "hot": "rose-4",
        "period_s": 9.0
      }
    },
    {
      "id": "strobe",
      "name": "Strobe",
      "kind": "strobe",
      "desc": "Hard alternation between two colours. Use sparingly \u2014 it is loud.",
      "params": {
        "a": "rose-4",
        "b": "neutral-1",
        "period_s": 0.7
