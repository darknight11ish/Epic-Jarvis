 {
  "type": "function",
  "function": {
   "name": "memory_search",
   "description": "Search the facts Jarvis has learned about the owner. For the owner's own notes, use notes_search.",
   "parameters": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string"
     },
     "k": {
      "type": "integer",
      "description": "how many facts, default 5"
     }
    },
    "required": [
     "query"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "file_read",
   "description": "Read a local text file.",
   "parameters": {
    "type": "object",
    "properties": {
     "path": {
      "type": "string"
     }
    },
    "required": [
     "path"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "shell_exec",
   "description": "Run one shell command on this machine and return its output.",
   "parameters": {
    "type": "object",
    "properties": {
     "command": {
      "type": "string"
     },
     "timeout_seconds": {
      "type": "number"
     }
    },
    "required": [
     "command"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "control_computer",
   "description": "Click or type in another Windows program by naming its on-screen controls. A control that cannot be found is reported, not guessed.",
   "parameters": {
    "type": "object",
    "properties": {
     "goal": {
      "type": "string"
     },
     "window": {
      "type": "string",
      "description": "the exact window title"
     },
     "requests": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "control": {
         "type": "string"
        },
        "action": {
         "type": "string",
         "enum": [
          "click",
          "type",
          "select",
          "read"
         ]
        },
        "value": {
         "type": "string"
        },
        "why": {
         "type": "string"
        },
        "irreversible": {
         "type": "boolean"
        },
        "leaves_machine": {
         "type": "boolean"
        }
       }
      }
     }
    },
    "required": [
     "goal",
     "window",
     "requests"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "control_phone",
   "description": "Tap, swipe, type, press a key or take a screenshot on the owner's paired Android phone.",
   "parameters": {
    "type": "object",
    "properties": {
     "device": {
      "type": "string"
     },
     "goal": {
      "type": "string"
     },
     "requests": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "action": {
         "type": "string",
         "enum": [
          "tap",
          "swipe",
          "key",
          "text",
          "screenshot"
         ]
        },
        "x": {
         "type": "integer"
        },
        "y": {
         "type": "integer"
        },
        "x1": {
         "type": "integer"
        },
        "y1": {
         "type": "integer"
        },
        "x2": {
         "type": "integer"
        },
        "y2": {
         "type": "integer"
        },
        "key": {
         "type": "string"
        },
        "value": {
         "type": "string"
        },
        "why": {
         "type": "string"
        },
        "irreversible": {
         "type": "boolean"
        },
        "leaves_machine": {
         "type": "boolean"
        }
       }
      }
     }
    },
    "required": [
     "device",
     "goal",
     "requests"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "github_search",
   "description": "Check GitHub for an existing library for a coding idea, graded by maintenance and licence.",
   "parameters": {
    "type": "object",
    "properties": {
     "idea": {
      "type": "string"
     },
     "capabilities": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "idea"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "calendar_read",
   "description": "Read the owner's calendar events for the next N days. Read-only. For messages, use email_check.",
   "parameters": {
    "type": "object",
    "properties": {
     "days_ahead": {
      "type": "integer",
      "description": "default 7, max 90"
     }
    }
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "email_check",
   "description": "Read recent messages in the owner's inbox: sender, subject, date, preview. Read-only; never sends. For appointments and events, use calendar_read.",
   "parameters": {
    "type": "object",
    "properties": {
     "limit": {
      "type": "integer",
      "description": "default 10, max 25"
     },
     "unread_only": {
      "type": "boolean",
      "description": "default true"
     }
    }
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "notes_search",
   "description": "Search the owner's own notes (Obsidian or Joplin). Read-only. For facts Jarvis remembers about the owner, use memory_search.",
   "parameters": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string"
     },
     "limit": {
      "type": "integer",
      "description": "default 10, max 20"
     }
    },
    "required": [
     "query"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "home_read",
   "description": "Read the state of named Home Assistant entities. Read-only. To change something, use home_control.",
   "parameters": {
    "type": "object",
    "properties": {
     "entity_ids": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "e.g. [\"light.kitchen\"], max 20"
     }
    },
    "required": [
     "entity_ids"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "home_control",
   "description": "Call one Home Assistant service on one entity, e.g. turn a light on or unlock a door. Changes something real. To only check a state, use home_read.",
   "parameters": {
    "type": "object",
    "properties": {
     "domain": {
      "type": "string",
      "description": "e.g. \"light\""
     },
     "service": {
      "type": "string",
      "description": "e.g. \"turn_on\""
     },
     "entity_id": {
      "type": "string"
     },
     "data": {
      "type": "object",
      "description": "e.g. {\"brightness\": 200}"
     }
    },
    "required": [
     "domain",
     "service",
     "entity_id"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "append_logseq_journal",
   "description": "Add one entry to today's Logseq journal page. Only adds.",
   "parameters": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string",
      "description": "in the owner's words"
     }
    },
    "required": [
     "text"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "append_obsidian_daily",
   "description": "Add one entry to today's Obsidian daily note. Only adds. For a separate note with its own title, use create_joplin_note.",
   "parameters": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string",
      "description": "in the owner's words"
     }
    },
    "required": [
     "text"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "create_joplin_note",
   "description": "Create one new note in Joplin. Never edits a note or makes a notebook. To add to today's daily note, use append_obsidian_daily.",
   "parameters": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string"
     },
     "body": {
      "type": "string"
     },
     "notebook": {
      "type": "string",
      "description": "an existing notebook's exact name (optional)"
     }
    },
    "required": [
     "title",
     "body"
    ]
   }
  }
 }
]